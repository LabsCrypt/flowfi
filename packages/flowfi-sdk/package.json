{
  "name": "@flowfi/sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the FlowFi API, generated from the OpenAPI spec via scripts/generate-sdk.sh",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "codegen": "../../scripts/generate-sdk.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}