        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "flowfi_db_query_duration_seconds_count{operation=\"SELECT:IndexerDeadLetterEvent\"}",
