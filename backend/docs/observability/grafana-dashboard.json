      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(flowfi_rpc_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{method}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, method) (rate(flowfi_rpc_request_duration_seconds_bucket[$__rate_interval])))",
